rules_version = '2';

// Covered by src/test/rules/firestore.rules.test.js — run `npm run test:rules`.
//
// These rules had drifted for eight months: the deployed ruleset carried three
// match blocks while this file carried seven, so several features were denied in
// production while the file looked correct. Rules now deploy from CI, and the
// tests gate that deploy.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function profile(appId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)).data;
    }

    function hasProfile(appId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid));
    }

    function isAdmin(appId) {
      return hasProfile(appId) && profile(appId).isAdmin == true;
    }

    function isContributor(appId) {
      return hasProfile(appId) && profile(appId).isContributor == true;
    }

    function canWriteContent(appId) {
      return isAdmin(appId) || isContributor(appId);
    }

    // Roles and entitlements are granted ONLY by the Admin SDK (the invite-
    // redemption Cloud Function for contributor; by hand in the console for
    // admin and isPro). They live on the user's own profile document, which the
    // user may otherwise write — so without this guard any authenticated account,
    // including an anonymous guest, could set isAdmin or isPro on itself.
    function touchesRoles() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['isAdmin', 'isContributor', 'isPro']);
    }

    function declaresRoles() {
      return request.resource.data.keys().hasAny(['isAdmin', 'isContributor', 'isPro']);
    }

    // ---------------------------------------------------------------------
    // User profile. Read/write your own, except the role fields.
    // ---------------------------------------------------------------------
    match /artifacts/{appId}/users/{userId} {
      allow read:   if isSelf(userId);
      allow create: if isSelf(userId) && !declaresRoles();
      allow update: if isSelf(userId) && !touchesRoles();
      allow delete: if isSelf(userId);
    }

    // User-owned subcollections: collection, decks, versions, gamelogs.
    // Requiring at least one segment after {userId} keeps this from also
    // matching the profile document and re-opening the role guard above.
    match /artifacts/{appId}/users/{userId}/{sub}/{document=**} {
      allow read, write: if isSelf(userId);
    }

    // ---------------------------------------------------------------------
    // Card database. Written by the pipeline through the Admin SDK, which
    // bypasses rules; never writable from a client.
    // ---------------------------------------------------------------------
    match /artifacts/{appId}/public/data/cardDatabase/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Prebuilt (precon) decks: written by the weekly sync (Admin SDK) and
    // reviewed/published by admins in the admin console.
    match /artifacts/{appId}/public/data/prebuiltDecks/{deckId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(appId);
    }

    // ---------------------------------------------------------------------
    // Public deck sharing.
    //
    // Path is `publicDecks/{slug}` (4 segments). The previous
    // `public/decks/{slug}` was 5 segments — a collection path — so doc() threw
    // before rules were ever consulted and sharing had never worked.
    // ---------------------------------------------------------------------
    // Shared decks: known fields, bounded size. No slug-format check, so
    // every link already shared keeps working.
    function isPublicDeckBody() {
      let d = request.resource.data;
      return d.keys().hasOnly(['deckId', 'uid', 'name', 'description', 'leaderId', 'baseId', 'cards',
                               'aspects', 'format', 'tags', 'totalCards', 'publishedAt'])
        && d.name is string && d.name.size() <= 200
        && (!('description' in d) || (d.description is string && d.description.size() <= 2000))
        && (!('cards' in d) || (d.cards is map && d.cards.size() <= 200))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 20));
    }

    match /artifacts/{appId}/publicDecks/{slug} {
      // Anyone with the link; never a listing of every shared deck.
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isPublicDeckBody();
      // Update needs the existing owner too: checking only the new data let
      // any signed-in user take over a shared deck by writing their own uid.
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && isPublicDeckBody();
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Shared trade/wants lists: a self-contained public copy of a saved list
    // (users/{uid}/lists/{id}), readable by anyone with the link.
    // ---------------------------------------------------------------------
    // The page lives on our domain and is posted to Discord, so its shape is
    // pinned: app-made codes only (no vanity /list/free-packs), known fields,
    // bounded size.
    function isPublicListBody(code) {
      let d = request.resource.data;
      return code.matches('^[a-hjkmnp-z2-9]{8}$')
        && d.keys().hasOnly(['uid', 'kind', 'name', 'showPrices', 'lines', 'cards', 'value', 'pricesAsOf', 'updatedAt'])
        && d.kind in ['trade', 'wants']
        && d.name is string && d.name.size() <= 200
        && d.lines is list && d.lines.size() <= 5000;
    }

    match /artifacts/{appId}/publicLists/{code} {
      // Anyone with the link; never a listing of every shared list.
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isPublicListBody(code);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && isPublicListBody(code);
      // A copy already gone (stopped on another device) must not block
      // deleting or unsharing the list in the same batch.
      allow delete: if isSignedIn()
        && (resource == null || resource.data.uid == request.auth.uid);
    }

    // ---------------------------------------------------------------------
    // Card submissions. Anyone signed in may submit; only the author or a
    // reviewer may read one back.
    // ---------------------------------------------------------------------
    match /artifacts/{appId}/submissions/{submissionId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read:   if isSignedIn()
        && (resource.data.uid == request.auth.uid || canWriteContent(appId));
      allow update, delete: if canWriteContent(appId);
    }

    // ---------------------------------------------------------------------
    // Admin surfaces. Written by the sync pipeline via the Admin SDK.
    // ---------------------------------------------------------------------
    match /artifacts/{appId}/admin/{document=**} {
      allow read: if isAdmin(appId);
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Contributor invites. An invitee never reads this collection: they present
    // a code and a Cloud Function grants the role with the Admin SDK. Keeping it
    // admin-only means invite codes cannot be enumerated.
    // ---------------------------------------------------------------------
    match /artifacts/{appId}/contributorInvites/{inviteId} {
      allow read, write: if isAdmin(appId);
    }

    // ---------------------------------------------------------------------
    // Contributor content.
    // ---------------------------------------------------------------------
    match /artifacts/{appId}/shells/{shellId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canWriteContent(appId);
    }

    match /artifacts/{appId}/packets/{packetId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canWriteContent(appId);
    }

    // ---------------------------------------------------------------------
    // Card scanner. The daily limit and each user's usage counter are read
    // and written only by the scanCard Cloud Function (Admin SDK). A client
    // that could write its own counter could scan without limit.
    // ---------------------------------------------------------------------
    match /artifacts/{appId}/config/{document=**} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/scanUsage/{document=**} {
      allow read, write: if false;
    }

    // Legacy `sync_*` collections are retired. The migration window expired
    // 2025-02-01 and those users were already locked out; the rule is removed
    // rather than extended, along with the legacy path in App.jsx.
  }
}
